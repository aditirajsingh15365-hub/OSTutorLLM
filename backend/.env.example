# Copy this file to .env and fill in your values. Never commit .env.
# On Render, set these same names under the service's Environment tab instead.
GEMINI_API_KEY=
# "gemini" calls the real model, "mock" returns canned responses (no API key needed).
LLM_MODE=gemini
# Run `python -m scripts.list_models` to see the model IDs available to your key.
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated frontend origins allowed by CORS (no trailing slash).
# Local dev + your deployed Vercel URL, for example:
#   http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: regex for Vercel preview URLs, e.g. https://your-project-.*\.vercel\.app
CORS_ORIGIN_REGEX=
